# =============================================================================
# AI MultiColony Ecosystem — Consolidated Environment Variables
# Version 3.0.0
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# Sections:
#   1. Core System Settings
#   2. Database (PostgreSQL + Redis + Qdrant)
#   3. LLM Provider API Keys (shared across all packages)
#   4. Crucix OSINT Configuration
#   5. Deer Flow Agent Platform Configuration
#   6. Autonomous Organism Configuration
#   7. Hermes Quant Trading Bot Configuration
#   8. AI MultiColony Core Configuration
#   9. Security & Encryption
#  10. Web Interface & Dashboard
#  11. Monitoring & Observability
#  12. Docker & Deployment
# =============================================================================

# =============================================================================
# 1. CORE SYSTEM SETTINGS
# =============================================================================
APP_ENV=development
SECRET_KEY=change-me-to-a-strong-random-string
LOG_LEVEL=INFO
LOG_DIR=./logs
DATA_DIR=./data

# =============================================================================
# 2. DATABASE
# =============================================================================

# --- PostgreSQL (primary database) ---
POSTGRES_DB=multicolony
POSTGRES_USER=multicolony
POSTGRES_PASSWORD=multicolony_dev
DATABASE_URL=postgresql://multicolony:multicolony_dev@localhost:5432/multicolony

# --- SQLite (fallback / development) ---
SQLITE_DATABASE_PATH=data/multicolony.db

# --- Redis (cache + message broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333

# --- ChromaDB (alternative vector store) ---
CHROMA_PERSIST_DIR=data/chroma

# =============================================================================
# 3. LLM PROVIDER API KEYS (shared across all packages)
# =============================================================================
# Only configure the providers you intend to use.
# The gateway will skip unconfigured providers and failover to the next.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORG_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google AI / Gemini ---
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- LLM7 (free tier) ---
LLM7_API_KEY=

# --- Hugging Face ---
HUGGINGFACE_API_KEY=

# --- Groq ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- NVIDIA ---
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# --- Mistral ---
MISTRAL_API_KEY=

# --- xAI / Grok ---
GROK_API_KEY=

# --- Minimax ---
MINIMAX_API_KEY=

# --- OpenCode ---
OPENCODE_API_KEY_1=
OPENCODE_API_KEY_2=
OPENCODE_API_BASE=https://api.opencode.ai/v1

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Default LLM Settings ---
DEFAULT_LLM_PROVIDER=llm7
DEFAULT_LLM_MODEL=default
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
MODEL_NAME=meta/llama-3.1-nemotron-70b-instruct

# =============================================================================
# 4. CRUCIX OSINT CONFIGURATION
# =============================================================================
CRUCIX_PORT=3117
CRUCIX_HOST=0.0.0.0

# Crucix LLM layer (optional — adds AI-powered briefing synthesis)
# Uses the shared LLM keys above; no separate keys needed.

# Crucix Alert Channels
CRUCIX_TELEGRAM_BOT_TOKEN=
CRUCIX_TELEGRAM_CHAT_ID=
CRUCIX_DISCORD_WEBHOOK_URL=

# =============================================================================
# 5. DEER FLOW AGENT PLATFORM CONFIGURATION
# =============================================================================

# --- Backend (FastAPI) ---
DEER_FLOW_API_HOST=0.0.0.0
DEER_FLOW_API_PORT=8001
DEER_FLOW_DATABASE_URL=sqlite:///./deerflow.db

# --- Auth ---
DEER_FLOW_AUTH_DISABLED=true
DEER_FLOW_ADMIN_USERNAME=admin
DEER_FLOW_ADMIN_PASSWORD=changeme

# --- LangGraph ---
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=deer-flow

# --- MCP (Model Context Protocol) ---
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=5000

# --- Channel Integrations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Sandbox ---
DOCKER_SANDBOX_ENABLED=false
DOCKER_SANDBOX_IMAGE=python:3.11-slim

# =============================================================================
# 6. AUTONOMOUS ORGANISM CONFIGURATION
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Organism Settings ---
ORGANISM_AUTO_EVOLVE=false
ORGANISM_MAX_GENERATIONS=100
ORGANISM_MUTATION_RATE=0.1

# =============================================================================
# 7. HERMES QUANT TRADING BOT CONFIGURATION
# =============================================================================

# --- Primary LLM: NVIDIA Nemotron 70B ---
HERMES_NVIDIA_API_KEY=nvapi-xxxxx
HERMES_OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
HERMES_MODEL_NAME=meta/llama-3.1-nemotron-70b-instruct

# --- Vision API (for chart_vision tool) ---
OPENAI_VISION_KEY=
VISION_PROVIDER=openai

# --- Wallet Addresses (NEVER hardcode in source code) ---
WALLET_TRON=
WALLET_SHIBA=

# --- Hermes System ---
HERMES_MAX_RESTART_ATTEMPTS=0
HERMES_RESTART_DELAY=5

# --- Market Data ---
YFINANCE_CACHE_DIR=./data/yfinance

# =============================================================================
# 8. AI MULTICOLONY CORE CONFIGURATION
# =============================================================================

# --- Colony Orchestration ---
COLONY_MAX_AGENTS=50
COLONY_SCHEDULER_INTERVAL=60
COLONY_COORDINATOR_STRATEGY=round-robin

# --- Memory ---
MEMORY_VECTOR_STORE=chromadb
MEMORY_SESSION_TTL=3600
MEMORY_MAX_CONTEXT_TOKENS=8192

# --- Tools ---
ENABLE_CODE_EXECUTION=true
ENABLE_BROWSER_AUTOMATION=true
ENABLE_VOICE_AGENT=false

# =============================================================================
# 9. SECURITY & ENCRYPTION
# =============================================================================
CREDENTIAL_MASTER_PASSWORD=change-me-to-a-strong-password
CREDENTIAL_ENCRYPTION_ITERATIONS=100000
SESSION_TIMEOUT=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
API_RATE_LIMIT=100

# =============================================================================
# 10. WEB INTERFACE & DASHBOARD
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CRUCIX_URL=http://localhost:3117
FLASK_ENV=development
FLASK_DEBUG=1
WEB_INTERFACE_PORT=5000
WEB_INTERFACE_HOST=0.0.0.0

# PWA Settings
PWA_CACHE_NAME=multicolony-v3
PWA_OFFLINE_PAGE=/offline.html

# =============================================================================
# 11. MONITORING & OBSERVABILITY
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# 12. DOCKER & DEPLOYMENT
# =============================================================================
COMPOSE_PROJECT_NAME=multicolony
DOCKER_REGISTRY=
DOCKER_TAG=latest
