# =============================================================================
# Quant-Nanggroe-AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env files to version control.
# =============================================================================

# =============================================================================
# QNAI_* — Quant Nanggroe Settings
# =============================================================================

# --- Application ---
QNAI_APP_NAME=Quant Nanggroe AI
QNAI_VERSION=0.1.0
QNAI_DEBUG=false
QNAI_LOG_LEVEL=INFO
QNAI_LOG_FORMAT=json

# --- Database ---
QNAI_DATABASE_URL=sqlite:///quant_nanggroe.db
# Production PostgreSQL:
# QNAI_DATABASE_URL=postgresql://qnai:qnai@localhost:5432/qnai

# --- Redis ---
QNAI_REDIS_URL=

# --- CORS ---
# Comma-separated list of allowed origins
QNAI_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- LLM Provider API Keys ---
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_NVIDIA_API_KEY=

# --- LLM Defaults ---
QNAI_DEFAULT_LLM_PROVIDER=openai
QNAI_DEFAULT_LLM_MODEL=gpt-4o
QNAI_DEFAULT_LLM_TEMPERATURE=0.0

# --- NVIDIA NIM ---
QNAI_NVIDIA_NIM_API_KEY=
QNAI_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
QNAI_NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# --- Market Data API Keys ---
# Alpaca: Free US equity real-time data (free tier available)
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_API_SECRET=
QNAI_ALPACA_PAPER=true

# Polygon: Production-grade historical data ($29/mo)
QNAI_POLYGON_API_KEY=

# Alpha Vantage: Free tier (25 req/day)
QNAI_ALPHA_VANTAGE_API_KEY=

# TwelveData: Global forex and equity data
QNAI_TWELVEDATA_API_KEY=

# FRED: Federal Reserve Economic Data (free, 120 req/min)
QNAI_FRED_API_KEY=

# CoinGecko: Pro API key (free tier works without key)
QNAI_COINGECKO_API_KEY=

# Finnhub: Free tier (60 calls/min)
QNAI_FINNHUB_API_KEY=

# SEC EDGAR: User-Agent email (required, no key needed)
QNAI_SEC_EDGAR_USER_EMAIL=

# ECB: Not needed (API is free)
QNAI_ECB_API_KEY=

# --- Exchange API Keys ---
# Binance (crypto)
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_API_SECRET=

# --- Constitutional Risk Limits ---
QNAI_RISK_MAX_PER_TRADE=0.5
QNAI_RISK_MAX_DAILY_LOSS=1.0
QNAI_RISK_MAX_WEEKLY_LOSS=3.0
QNAI_RISK_MAX_DRAWDOWN=10.0

# --- Backtesting ---
QNAI_BACKTEST_DEFAULT_COMMISSION=0.001
QNAI_BACKTEST_DEFAULT_SLIPPAGE=0.0005
QNAI_BACKTEST_DEFAULT_INITIAL_CAPITAL=100000.0

# --- Data ---
QNAI_DATA_CACHE_TTL=300
QNAI_DATA_PROVIDER_TIMEOUT=30

# =============================================================================
# MULTICOLONY_* — AI MultiColony Settings
# =============================================================================

# --- Core ---
MULTICOLONY_APP_NAME=ai-multicolony
MULTICOLONY_VERSION=0.1.0
MULTICOLONY_DEBUG=false
MULTICOLONY_LOG_LEVEL=INFO

# --- LLM ---
MULTICOLONY_LLM_PROVIDER=openai
MULTICOLONY_LLM_MODEL=gpt-4o
MULTICOLONY_LLM_API_KEY=
MULTICOLONY_LLM_BASE_URL=
MULTICOLONY_LLM_TEMPERATURE=0.7
MULTICOLONY_LLM_MAX_TOKENS=4096
MULTICOLONY_LLM_TIMEOUT=60

# --- Sandbox ---
MULTICOLONY_SANDBOX_DOCKER_ENABLED=true
MULTICOLONY_SANDBOX_WASM_ENABLED=false
MULTICOLONY_SANDBOX_STARTUP_TIMEOUT=30

# --- Browser ---
MULTICOLONY_BROWSER_STEALTH_MODE=true
MULTICOLONY_BROWSER_HEADLESS=true
MULTICOLONY_BROWSER_POOL_SIZE=5
MULTICOLONY_BROWSER_PAGE_TIMEOUT=30000
MULTICOLONY_BROWSER_STEALTH_TARGET_SCORE=0.9

# --- API ---
MULTICOLONY_API_HOST=0.0.0.0
MULTICOLONY_API_PORT=8000
MULTICOLONY_API_WORKERS=4
# IMPORTANT: Set a strong JWT secret in production!
MULTICOLONY_API_JWT_SECRET=
MULTICOLONY_API_JWT_EXPIRY_HOURS=24
MULTICOLONY_API_API_KEY_ENABLED=true
MULTICOLONY_API_RATE_LIMIT_PER_MINUTE=60
MULTICOLONY_API_RATE_LIMIT_BURST=10
MULTICOLONY_API_REQUEST_TIMEOUT_S=30
MULTICOLONY_API_WS_HEARTBEAT_S=30
MULTICOLONY_API_WS_MAX_CONNECTIONS=100

# --- Colony ---
MULTICOLONY_COLONY_HEARTBEAT_INTERVAL_MS=30000
MULTICOLONY_COLONY_MAX_AGENTS=50
MULTICOLONY_COLONY_DEFAULT_AUTONOMY=1
MULTICOLONY_COLONY_ROUTING_STRATEGY=least-loaded
MULTICOLONY_COLONY_A2A_ENABLED=true
MULTICOLONY_COLONY_INTER_COLONY_ENABLED=true
MULTICOLONY_COLONY_SKILL_SHARING=true
MULTICOLONY_COLONY_HEALTH_CHECK_INTERVAL_MS=60000
MULTICOLONY_COLONY_HEALTH_SCORE_THRESHOLD=0.5

# --- MCP ---
MULTICOLONY_MCP_SERVER_PORT=8081
MULTICOLONY_MCP_SSE_PORT=8080
MULTICOLONY_MCP_MAX_CONNECTIONS=1000
MULTICOLONY_MCP_RATE_LIMIT_RPM=60
MULTICOLONY_MCP_RATE_LIMIT_BURST=10
MULTICOLONY_MCP_AUDIT_ENABLED=true
MULTICOLONY_MCP_CIRCUIT_BREAKER_THRESHOLD=5
MULTICOLONY_MCP_CIRCUIT_BREAKER_TIMEOUT_S=60
MULTICOLONY_MCP_CIRCUIT_BREAKER_HALF_OPEN_MAX=3
MULTICOLONY_MCP_TRANSPORT=stdio

# --- Memory ---
MULTICOLONY_MEMORY_PAGE_SIZE=4096
MULTICOLONY_MEMORY_COMPACTION_THRESHOLD=0.8
MULTICOLONY_MEMORY_WORKING_SET_SIZE=1024
MULTICOLONY_MEMORY_SUMMARY_MAX_TOKENS=512
MULTICOLONY_MEMORY_MAX_PAGES_PER_SESSION=100
MULTICOLONY_MEMORY_PAGE_RETENTION_DAYS=90
MULTICOLONY_MEMORY_PRELOAD_ENABLED=true
MULTICOLONY_MEMORY_PRELOAD_TOP_K=3
MULTICOLONY_MEMORY_VECTOR_DB_URL=http://localhost:6333
MULTICOLONY_MEMORY_VECTOR_DB_COLLECTION=colony-general
MULTICOLONY_MEMORY_VECTOR_EMBEDDING_DIMS=1536
MULTICOLONY_MEMORY_VECTOR_DISTANCE=Cosine
MULTICOLONY_MEMORY_COMPACTION_INTERVAL_S=300

# --- Security ---
MULTICOLONY_SECURITY_AUDIT_LEVEL=full
MULTICOLONY_SECURITY_AUDIT_STORAGE=memory
MULTICOLONY_SECURITY_AUDIT_FILE_PATH=/var/log/multicolony/audit.jsonl
MULTICOLONY_SECURITY_AUDIT_RETENTION_DAYS=90
MULTICOLONY_SECURITY_AUDIT_FLUSH_INTERVAL_S=10
MULTICOLONY_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
MULTICOLONY_SECURITY_CREDENTIAL_ENCRYPTION_ENABLED=true
MULTICOLONY_SECURITY_AUTO_APPROVE_L0_TO_L1=true
MULTICOLONY_SECURITY_ESCALATION_DEFAULT_TTL_S=3600
MULTICOLONY_SECURITY_APPROVAL_TIMEOUT_S=300

# --- Channels (Telegram / WhatsApp / Discord / Slack) ---
MULTICOLONY_CHANNEL_TELEGRAM_BOT_TOKEN=
MULTICOLONY_CHANNEL_TELEGRAM_API_URL=https://api.telegram.org
MULTICOLONY_CHANNEL_TELEGRAM_WEBHOOK_URL=
MULTICOLONY_CHANNEL_WHATSAPP_API_KEY=
MULTICOLONY_CHANNEL_WHATSAPP_API_URL=https://api.whatsapp.com
MULTICOLONY_CHANNEL_WHATSAPP_PHONE_NUMBER_ID=
MULTICOLONY_CHANNEL_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
MULTICOLONY_CHANNEL_DISCORD_BOT_TOKEN=
MULTICOLONY_CHANNEL_DISCORD_APPLICATION_ID=
MULTICOLONY_CHANNEL_DISCORD_GUILD_ID=
MULTICOLONY_CHANNEL_SLACK_BOT_TOKEN=
MULTICOLONY_CHANNEL_SLACK_SIGNING_SECRET=
MULTICOLONY_CHANNEL_SLACK_APP_TOKEN=
