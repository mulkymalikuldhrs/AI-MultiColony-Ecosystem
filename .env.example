# =============================================================================
# AI-MultiColony-Ecosystem — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control.
# =============================================================================

# --- Required ---
# JWT secret for API authentication (REQUIRED in production)
# In development, set MULTICOLONY_DEV_MODE=true to bypass this check.
MULTICOLONY_API_JWT_SECRET=

# --- Development Mode ---
# Set to true to bypass production security validations (JWT secret, etc.)
# Default: false
MULTICOLONY_DEV_MODE=false

# --- CORS Configuration ---
# Comma-separated list of allowed origins, methods, and headers.
# Leave empty for restrictive defaults (no CORS headers sent).
# WARNING: Using "*" allows all — insecure for production.
MULTICOLONY_API_CORS_ORIGINS=
MULTICOLONY_API_CORS_METHODS=
MULTICOLONY_API_CORS_HEADERS=

# --- Database Configuration ---
# SQLite (default for development):
DATABASE_URL=sqlite:///data/multicolony.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/multicolony

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider API Keys ---
# At least one provider must be configured for live agent execution.
# Default provider is set via MULTICOLONY_LLM_PROVIDER (openai, anthropic, google, ollama)
MULTICOLONY_LLM_API_KEY=
MULTICOLONY_LLM_PROVIDER=openai
MULTICOLONY_LLM_MODEL=gpt-4o

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google
GOOGLE_API_KEY=

# --- NIM API Key (NVIDIA Inference Microservices) ---
NIM_API_KEY=

# --- LLM7 Provider ---
LLM7_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Camel AI ---
CAMEL_API_KEY=

# --- Application Settings ---
MULTICOLONY_DEBUG=false
MULTICOLONY_LOG_LEVEL=INFO

# --- API Server ---
MULTICOLONY_API_HOST=0.0.0.0
MULTICOLONY_API_PORT=8000
MULTICOLONY_API_WORKERS=4

# --- Channel Bot Tokens ---
# Telegram
MULTICOLONY_CHANNEL_TELEGRAM_BOT_TOKEN=

# WhatsApp
MULTICOLONY_CHANNEL_WHATSAPP_API_KEY=

# Discord
MULTICOLONY_CHANNEL_DISCORD_BOT_TOKEN=

# Slack
MULTICOLONY_CHANNEL_SLACK_BOT_TOKEN=

# --- Security ---
MULTICOLONY_SECURITY_CREDENTIAL_ENCRYPTION_KEY=

# --- Vector DB (Qdrant) ---
MULTICOLONY_MEMORY_VECTOR_DB_URL=http://localhost:6333

# =============================================================================
# Quant-Nanggroe-AI — Legacy Environment Variables
# =============================================================================
# These are for the quant_nanggroe package and are kept for backward compat.

# --- LLM Provider API Keys (Legacy) ---
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_LLM_PROVIDER=openai

# --- Market Data API Keys (Legacy) ---
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_SECRET_KEY=
QNAI_POLYGON_API_KEY=
QNAI_TWELVEDATA_API_KEY=

# --- Database Configuration (Legacy) ---
QNAI_DATABASE_URL=sqlite:///data/quant.db
QNAI_REDIS_URL=redis://localhost:6379/0
QNAI_CHROMA_URL=http://localhost:8001

# --- Exchange API Keys (Legacy) ---
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_SECRET_KEY=
QNAI_BYBIT_API_KEY=
QNAI_BYBIT_SECRET_KEY=

# --- Application Settings (Legacy) ---
QNAI_DEBUG=true
QNAI_ENV=development
QNAI_LOG_LEVEL=INFO
