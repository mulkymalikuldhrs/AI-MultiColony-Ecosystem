# === General ===
APP_ENV=development
APP_NAME=AI-MultiColony-Ecosystem
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# === LLM API Keys ===
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key

# === Azure OpenAI ===
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# === Database ===
DATABASE_URL=sqlite:///./data/ecosystem.db

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_multicolony

# === ChromaDB ===
CHROMA_PERSIST_DIRECTORY=./data/chroma

# === Sandbox ===
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true

# === Browser ===
BROWSER_HEADLESS=true
BROWSER_STEALTH_MODE=true
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_PAGE_TIMEOUT=30000
BROWSER_NAVIGATION_TIMEOUT=60000

# === Security ===
SECURITY_ENABLE_AUDIT=true
SECURITY_SANDBOX_ALL_COMMANDS=false
SECURITY_MAX_FILE_SIZE_MB=50

# === MCP ===
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=5000

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_KEY=

# === Channel API Keys ===
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
